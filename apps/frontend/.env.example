# ==========================================
# Variables de Entorno — Frontend React Vite
# ==========================================

# URL base del Backend API
VITE_API_URL=http://localhost:3000/api/v1

# Activar pestaña del simulador de eventos de Recepción (Check-out / Check-in)
VITE_DEMO_MODE=true

# Ruta base de despliegue (para GitHub Pages usar /<nombre-del-repo>/ o ./)
VITE_BASE_PATH=./
