# ==========================================
# Variables de Entorno — Backend NestJS FR08
# ==========================================
PORT=3000
NODE_ENV=development

# Conexión PostgreSQL (Prisma)
DATABASE_URL=postgresql://hospedaje_user:hospedaje_pass_2026@localhost:5432/hospedaje_db?schema=public

# Autenticación JWT
JWT_SECRET=super-secret-jwt-key-2026-hospedaje
JWT_REFRESH_SECRET=super-secret-refresh-key-2026-hospedaje

# Integración con Recepción (X-API-Key entrante)
RECEPCION_API_KEY=demo-recepcion-key

# Integración con Reservaciones (Webhook saliente)
RESERVACIONES_WEBHOOK_URL=
RESERVACIONES_WEBHOOK_SECRET=demo-webhook-secret-2026

# Seguridad y CORS
CORS_ORIGIN=*

# Zona Horaria y Cron
TZ=America/Hermosillo
TURNO_CRON="0 7 * * *"

# Seed
SEED_DEMO_PASSWORD=DemoPass2026!
RUN_SEED=true
