{
  "name": "control-habitacion-monorepo",
  "version": "1.0.0",
  "description": "Procedimiento FR08 Control de Habitación - Resort",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build:shared": "npm --workspace=@control-habitacion/shared run build",
    "build:backend": "npm --workspace=@control-habitacion/backend run build",
    "build:frontend": "npm --workspace=@control-habitacion/frontend run build",
    "build": "npm run build:shared && npm run build:backend && npm run build:frontend",
    "dev:backend": "npm --workspace=@control-habitacion/backend run start:dev",
    "dev:frontend": "npm --workspace=@control-habitacion/frontend run dev",
    "dev": "npm run build:shared && concurrently -n \"backend,frontend\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "lint:shared": "npm --workspace=@control-habitacion/shared run lint",
    "lint:backend": "npm --workspace=@control-habitacion/backend run lint",
    "lint:frontend": "npm --workspace=@control-habitacion/frontend run lint",
    "lint": "npm run lint:shared && npm run lint:backend && npm run lint:frontend",
    "test:shared": "npm --workspace=@control-habitacion/shared run test",
    "test:backend": "npm --workspace=@control-habitacion/backend run test",
    "test:frontend": "npm --workspace=@control-habitacion/frontend run test",
    "test": "npm run test:backend && npm run test:frontend",
    "test:cov": "npm --workspace=@control-habitacion/backend run test:cov",
    "typecheck": "npm --workspace=@control-habitacion/shared run typecheck && npm --workspace=@control-habitacion/backend run typecheck && npm --workspace=@control-habitacion/frontend run typecheck",
    "prisma:generate": "npm --workspace=@control-habitacion/backend run prisma:generate",
    "prisma:migrate": "npm --workspace=@control-habitacion/backend run prisma:migrate",
    "prisma:seed": "npm --workspace=@control-habitacion/backend run prisma:seed",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "prettier": "^3.2.5",
    "rimraf": "^5.0.7",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
