# ========================================================
# Configuración Global del Entorno — FR08 Hospedaje Monorepo
# ========================================================

# Puerto local del servicio backend
PORT=3000

# Base de datos PostgreSQL
POSTGRES_USER=hospedaje_user
POSTGRES_PASSWORD=hospedaje_pass_2026
POSTGRES_DB=hospedaje_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://hospedaje_user:hospedaje_pass_2026@localhost:5432/hospedaje_db?schema=public

# Seguridad JWT (Tokens de acceso y refresco)
JWT_SECRET=super-secret-jwt-key-2026-hospedaje
JWT_REFRESH_SECRET=super-secret-refresh-key-2026-hospedaje

# Integración con Recepción (X-API-Key entrante)
RECEPCION_API_KEY=demo-recepcion-key

# Integración con Reservaciones (Webhook saliente con HMAC-SHA256)
# Dejar en blanco para guardar automáticamente en la bandeja de salida local (Modo Demo)
RESERVACIONES_WEBHOOK_URL=
RESERVACIONES_WEBHOOK_SECRET=demo-webhook-secret-2026

# Control de Orígenes CORS (en producción poner la URL de GitHub Pages)
CORS_ORIGIN=*

# Zona Horaria Operativa y Cron del Reporte Inicial
TZ=America/Hermosillo
TURNO_CRON="0 7 * * *"

# Credenciales de Demostración para el Seed
# Se aplicará a los 4 usuarios (gerente, supervisor, camarista, auxiliar)
SEED_DEMO_PASSWORD=DemoPass2026!
RUN_SEED=true

# Frontend
VITE_API_URL=http://localhost:3000/api/v1
VITE_DEMO_MODE=true
VITE_BASE_PATH=./
